{
  "name": "@verdeect/auth",
  "version": "1.0.0",
  "description": "Проверка access-токенов at+jwt для серверов ресурсов Вердикта 2.0: ядро на jose, модуль NestJS, тестовые помощники",
  "keywords": [
    "verdeect",
    "jwt",
    "at+jwt",
    "oauth2",
    "jwks",
    "nestjs",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smskin/verdeect-auth.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "development": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:package": "vitest run -c vitest.package.config.ts",
    "pack:check": "pnpm build && publint --strict && attw --pack . --profile esm-only && pnpm test:package"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.0",
    "fastify": "5.12.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
