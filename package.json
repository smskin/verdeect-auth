{
  "name": "verdeect-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./src/nest/index.ts",
      "development": "./src/nest/index.ts",
      "default": "./dist/nest/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "development": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/node": "22.20.5",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
